<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1.0-precios-historico-04" author="marana-dev">
        <comment>Creación de tabla de histórico de precios y costos de insumos</comment>
        <createTable tableName="historico_precios">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="sku" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="nombre_producto" type="VARCHAR(150)"/>
            <column name="precio_anterior_cop" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="precio_nuevo_cop" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="costo_lana_anterior" type="INT"/>
            <column name="costo_lana_nuevo" type="INT"/>
            <column name="motivo" type="VARCHAR(255)"/>
            <column name="usuario_responsable" type="VARCHAR(120)" defaultValue="Administración"/>
            <column name="created_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="historico_precios" indexName="idx_hist_precios_sku">
            <column name="sku"/>
        </createIndex>
        <createIndex tableName="historico_precios" indexName="idx_hist_precios_created_at">
            <column name="created_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>

