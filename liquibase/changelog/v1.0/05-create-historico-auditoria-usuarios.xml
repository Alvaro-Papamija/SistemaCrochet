<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1.0-auditoria-usuarios-05" author="marana-dev">
        <comment>Creación de tabla de auditoría de accesos y seguridad de usuarios</comment>
        <createTable tableName="historico_auditoria_usuarios">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="username" type="VARCHAR(60)"/>
            <column name="evento" type="VARCHAR(60)">
                <constraints nullable="false"/>
            </column>
            <column name="ip_address" type="VARCHAR(45)"/>
            <column name="user_agent" type="TEXT"/>
            <column name="detalles" type="TEXT"/>
            <column name="created_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="historico_auditoria_usuarios" indexName="idx_hist_audit_user">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="historico_auditoria_usuarios" indexName="idx_hist_audit_evento">
            <column name="evento"/>
        </createIndex>
        <createIndex tableName="historico_auditoria_usuarios" indexName="idx_hist_audit_created_at">
            <column name="created_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>

