<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1.0-comprobantes-historico-03" author="marana-dev">
        <comment>Creación de tabla de histórico de comprobantes y validación de pagos</comment>
        <createTable tableName="historico_comprobantes">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="comprobante_id" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="pedido_id" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="cliente_nombre" type="VARCHAR(120)"/>
            <column name="estado_anterior" type="VARCHAR(30)"/>
            <column name="estado_nuevo" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="codigo_aprobacion" type="VARCHAR(40)"/>
            <column name="monto_total" type="INT"/>
            <column name="metodo_pago" type="VARCHAR(80)"/>
            <column name="cuenta_banco" type="VARCHAR(120)"/>
            <column name="nota_interna" type="TEXT"/>
            <column name="revisado_por" type="VARCHAR(120)" defaultValue="Administración"/>
            <column name="created_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="historico_comprobantes" indexName="idx_hist_comp_id">
            <column name="comprobante_id"/>
        </createIndex>
        <createIndex tableName="historico_comprobantes" indexName="idx_hist_comp_pedido">
            <column name="pedido_id"/>
        </createIndex>
        <createIndex tableName="historico_comprobantes" indexName="idx_hist_comp_created_at">
            <column name="created_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>

